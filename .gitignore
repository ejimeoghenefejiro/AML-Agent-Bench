# Build outputs (.NET)
[Bb]in/
[Oo]bj/
[Oo]ut/
[Pp]ublish/
artifacts/

# Visual Studio / Rider / VSCode
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# dotnet
project.lock.json
*.nupkg
*.snupkg

# Python (synthetic data generator only)
__pycache__/
.pytest_cache/
*.pyc
.venv/

# Secrets / env  (NEVER commit; copy .env.example -> .env locally)
.env
*.env.local

# OS
.DS_Store
Thumbs.db

# Benchmark artefacts
/app/
aml_clusters.csv
aml-bench-*/

# Run-by-run result archives. The harness writes a consolidated bench_result
# JSON here for every run; over time this directory accumulates many files.
# Keep the README but ignore the JSONs themselves. Add specific runs with
# `git add -f results/<file>.json` when they are worth citing.
results/*.json

# Same pattern for the assurance-profile archive (see assurance/README.md).
# assurance/policy.default.json itself is tracked; only the generated
# per-run profiles are ignored.
assurance-profiles/*.json

# Machine-readable output of `aml-harness compare` / `regress` -- written to
# the current working directory each invocation, ephemeral like the above.
comparison_result.json
regression_result.json

# Raw results from research-validation experiments (repeated-run,
# judge-repeatability, noise/distractor, false-positive) -- regenerable, not
# source. validation/fixtures, validation/gold and validation/experiments
# (the inputs/config) are tracked; only validation/outputs (the results) is not.
validation/outputs/*
!validation/outputs/.gitkeep

# Third-party submissions — keep the directory and its README but ignore
# everyone else's agent code by default. Our own reference baselines are
# explicit exceptions so they ship with the bench.
submissions/*
!submissions/README.md
!submissions/python-baseline/
!submissions/python-baseline/**
